{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Fayne Academy",
  "description": "Documentation for Fayne Academy launch a branded online school in days, pre-loaded with professional courses and AI-powered customization.",
  "colors": {
    "primary": "#f3305a",
    "light": "#1c1c1c",
    "dark": "#f17cac"
  },
  "favicon": "https://media.brand.dev/092cb24e-1beb-4188-ba59-45cce85c6f59.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant"]
  },
  "logo": {
    "light": "/images/fayne-logo.png",
    "dark": "/images/fayne-logomark.png",
    "href": "https://fayneos.com"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Launch your academy",
      "href": "https://fayne.co"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "academy/owner-dashboard"
            ]
          },
          {
            "group": "Build your academy",
            "pages": [
              "academy/branding",
              "academy/home-page",
              "academy/courses",
              "academy/publishing-access",
              "academy/preview",
              "academy/custom-domain",
              "academy/email-domain",
              "academy/team",
              "academy/multiple-academies"
            ]
          },
          {
            "group": "Create content",
            "pages": [
              "content/course-library",
              "content/ai-course-generation",
              "content/block-editor",
              "content/ai-customization",
              "content/modules",
              "content/video-upload",
              "content/interactive-widgets",
              "content/knowledge"
            ]
          },
          {
            "group": "Sell your courses",
            "pages": [
              "academy/pricing",
              "payments/stripe-connect",
              "payments/pricing-models",
              "payments/offers",
              "payments/offer-pages",
              "payments/coupons"
            ]
          },
          {
            "group": "Manage students",
            "pages": [
              "students/managing-students",
              "students/invitations-emails",
              "students/enrollments",
              "students/certificates",
              "students/audiences",
              "students/student-experience"
            ]
          },
          {
            "group": "Engage students",
            "icon": "megaphone",
            "pages": [
              "engagement/newsfeed",
              "engagement/book-a-call"
            ]
          },
          {
            "group": "Learning Assistant",
            "icon": "bot",
            "pages": [
              "learning-assistant/overview",
              "learning-assistant/customization",
              "learning-assistant/conversations"
            ]
          },
          {
            "group": "Measure results",
            "pages": [
              "analytics/overview",
              "engagement/activity"
            ]
          },
          {
            "group": "Account and plans",
            "icon": "credit-card",
            "pages": [
              "billing/plans",
              "billing/subscription",
              "billing/referrals",
              "academy/settings",
              "engagement/whats-new"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "content/connect-ai-tools"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Authentication",
            "pages": [
              "api-reference/authentication"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/courses",
              "api-reference/students",
              "api-reference/enrollments",
              "api-reference/lists"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "api-reference/guides"
            ]
          }
        ]
      }
    ]
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "fonts": {
    "family": "Geist",
    "weight": 400
  },
  "background": {
    "color": {
      "dark": "#000000"
    }
  },
  "redirects": [
    {
      "source": "/academy/about-page",
      "destination": "/academy/home-page"
    }
  ]
}
